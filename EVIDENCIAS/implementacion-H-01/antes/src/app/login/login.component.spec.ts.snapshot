import '@angular/compiler';
import { HttpErrorResponse } from '@angular/common/http';
import { Router } from '@angular/router';
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
import { AuthService } from '../services/auth.service';
import { LoginComponent } from './login.component';

class MemoryStorage {
  private readonly values = new Map<string, string>();

  getItem(key: string): string | null {
    return this.values.get(key) ?? null;
  }

  setItem(key: string, value: string): void {
    this.values.set(key, value);
  }

  removeItem(key: string): void {
    this.values.delete(key);
  }

  clear(): void {
    this.values.clear();
  }
}

describe('LoginComponent characterization', () => {
  let storage: MemoryStorage;
  let router: Router;
  let navigate: ReturnType<typeof vi.fn>;
  let authService: AuthService;
  let login: ReturnType<typeof vi.fn>;

  beforeEach(() => {
    storage = new MemoryStorage();
    vi.stubGlobal('localStorage', storage);
    navigate = vi.fn().mockResolvedValue(true);
    router = { navigate } as unknown as Router;
    login = vi.fn();
    authService = { login } as unknown as AuthService;
    vi.spyOn(console, 'error').mockImplementation(() => undefined);
  });

  afterEach(() => {
    vi.restoreAllMocks();
    vi.unstubAllGlobals();
  });

  it('sends the documented login request and stores the successful session', async () => {
    const user = { username: 'student', displayName: 'Student' };
    login.mockResolvedValue({ token: 'test-token', user });
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = 'Workshop123!';

    await component.login();

    expect(login).toHaveBeenCalledWith({
      username: 'student',
      password: 'Workshop123!',
      client: 'angular-workshop'
    });
    expect(storage.getItem('workshop_token')).toBe('test-token');
    expect(storage.getItem('workshop_user')).toBe(JSON.stringify(user));
    expect(storage.getItem('workshop_preferences')).toBe(JSON.stringify(component.preferences));
    expect(navigate).toHaveBeenCalledWith(['/dashboard']);
    expect(component.busy).toBe(false);
  });

  it('does not send a request when username or password is blank', async () => {
    const component = new LoginComponent(router, authService);
    component.username = '   ';
    component.password = 'password';
    await component.login();
    expect(login).not.toHaveBeenCalled();
    expect(component.message).toBe('<strong>Ingrese un usuario.</strong>');

    component.username = 'student';
    component.password = '   ';
    await component.login();
    expect(login).not.toHaveBeenCalled();
    expect(component.message).toBe('<strong>Ingrese una contraseña.</strong>');
  });

  it('reports a response without token and does not navigate', async () => {
    login.mockResolvedValue({ user: { username: 'student' } });
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = 'password';

    await component.login();

    expect(component.message).toBe('<strong>El backend respondió sin token.</strong>');
    expect(navigate).not.toHaveBeenCalled();
    expect(component.busy).toBe(false);
  });

  it('prefers the backend error message and clears busy after a failed request', async () => {
    login.mockRejectedValue(new HttpErrorResponse({
      error: { message: 'Credenciales inválidas' },
      status: 401,
      statusText: 'Unauthorized'
    }));
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = 'bad';

    await component.login();

    expect(component.message).toContain('No se pudo autenticar a student.');
    expect(component.message).toContain('Credenciales inválidas');
    expect(component.busy).toBe(false);
  });

  it('falls back to the request message and then to the generic error', async () => {
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = 'bad';
    login.mockRejectedValueOnce(new Error('Request failed'));
    await component.login();
    expect(component.message).toContain('Request failed');

    login.mockRejectedValueOnce({});
    await component.login();
    expect(component.message).toContain('Error desconocido');
    expect(component.busy).toBe(false);
  });

  it.each([null, undefined, '', '   '])('rejects empty username %s without HTTP', async value => {
    const component = new LoginComponent(router, authService);
    component.username = value;
    component.password = 'password';
    await component.login();
    expect(component.message).toBe('<strong>Ingrese un usuario.</strong>');
    expect(login).not.toHaveBeenCalled();
    expect(navigate).not.toHaveBeenCalled();
    expect(component.busy).toBe(false);
  });

  it.each([null, undefined, '', '   '])('rejects empty password %s without HTTP', async value => {
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = value;
    await component.login();
    expect(component.message).toBe('<strong>Ingrese una contraseña.</strong>');
    expect(login).not.toHaveBeenCalled();
    expect(navigate).not.toHaveBeenCalled();
    expect(component.busy).toBe(false);
  });

  it.each([null, {}, { token: '' }, { token: null }])('handles a missing token: %j', async response => {
    login.mockResolvedValue(response);
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = 'password';
    await component.login();
    expect(component.message).toBe('<strong>El backend respondió sin token.</strong>');
    expect(storage.getItem('workshop_token')).toBeNull();
    expect(navigate).not.toHaveBeenCalled();
    expect(component.busy).toBe(false);
  });

  it.each([401, 403, 400, 500, 503])('handles HTTP %i without overwriting an existing session', async status => {
    storage.setItem('workshop_token', 'existing-token');
    const error = new HttpErrorResponse({ status, error: { message: 'Rejected' } });
    login.mockRejectedValue(error);
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = 'password';
    await component.login();
    expect(component.message).toContain('Rejected');
    expect(component.busy).toBe(false);
    expect(storage.getItem('workshop_token')).toBe('existing-token');
    expect(navigate).not.toHaveBeenCalled();
    expect(console.error).toHaveBeenCalledWith(error);
  });

  it.each(['network', 'cors', 'abort', 'timeout'])('handles transport failure: %s', async cause => {
    const error = new HttpErrorResponse({
      status: 0,
      statusText: cause === 'timeout' ? 'Request timeout' : 'Unknown Error',
      error: cause === 'timeout'
        ? new DOMException('Request timed out', 'TimeoutError')
        : { type: cause }
    });
    login.mockRejectedValue(error);
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = 'password';
    await component.login();
    expect(component.message).toContain(cause === 'timeout' ? 'Request timed out' : error.message);
    expect(component.busy).toBe(false);
    expect(navigate).not.toHaveBeenCalled();
  });

  it('handles a JSON parse error even when HTTP status is 200', async () => {
    const error = new HttpErrorResponse({
      status: 200,
      error: { error: new SyntaxError('Invalid JSON'), text: '{' }
    });
    login.mockRejectedValue(error);
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = 'password';
    await component.login();
    expect(component.message).toContain(error.message);
    expect(component.busy).toBe(false);
    expect(navigate).not.toHaveBeenCalled();
  });

  it('reports a storage write error instead of navigating', async () => {
    login.mockResolvedValue({ token: 'test-token', user: { username: 'student' } });
    vi.spyOn(storage, 'setItem').mockImplementation(() => { throw new Error('Storage unavailable'); });
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = 'password';
    await component.login();
    expect(component.message).toContain('Storage unavailable');
    expect(component.busy).toBe(false);
    expect(navigate).not.toHaveBeenCalled();
  });

  it('reports navigation rejection and restores the busy state', async () => {
    login.mockResolvedValue({ token: 'test-token', user: { username: 'student' } });
    navigate.mockRejectedValue(new Error('Navigation failed'));
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = 'password';
    await component.login();
    expect(component.message).toContain('Navigation failed');
    expect(component.busy).toBe(false);
    expect(console.error).toHaveBeenCalled();
  });

  it('logs invalid preferences and retains defaults', () => {
    storage.setItem('workshop_preferences', '{');
    const log = vi.spyOn(console, 'log').mockImplementation(() => undefined);
    const component = new LoginComponent(router, authService);
    expect(log).toHaveBeenCalledWith('Preferences could not be loaded', expect.any(SyntaxError));
    expect(component.preferences).toEqual({ theme: 'light', showTips: true, compact: false });
  });

  it('BUG-01: rejects an unexpected login body instead of persisting an invalid session', async () => {
    login.mockResolvedValue({ token: 'test-token' });
    const component = new LoginComponent(router, authService);
    component.username = 'student';
    component.password = 'password';
    await component.login();
    expect(navigate).not.toHaveBeenCalled();
    expect(storage.getItem('workshop_token')).toBeNull();
  });
});
